--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2MSB
  Type:    ET_DYN
  Machine: EM_AARCH64
Sections:
  - Name:    .text
    Type:    SHT_PROGBITS
    Flags:   [ SHF_ALLOC, SHF_EXECINSTR ]
    Address: 0x10000
    Size:    0xa0
  - Name:         .eh_frame_hdr
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC ]
    Address:      0x20000
    AddressAlign: 8
    ContentArray: [
                    0x03, 0x01, 0x00, 0x00,                  ## version 3, flags 0x1
                    0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x50, ## 2 pages, first level at 0x50
                    0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x40, ## 2 global descriptors at 0x40
                    0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x2c, ## 1 personalities at 0x2c
                    0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x30, ## 1 side tables, directory at 0x30
                    0x00, 0x00, 0x00, 0xc4, 0x00, 0x00, 0x00, 0x08, ## escapes at 0xc4, 8 bytes
                    0x00, 0x01, 0x00, 0x00,                  ## personality 0: pointer at 0x30000
                    0x01, 0x02, 0x04, 0x00, 0x00, 0x00, 0x00, 0xa0, 0x00, 0x00, 0x00, 0x01, ## side table kind 0x1: pc width 2, payload width 4, first level at 0xa0, 1 pages
                    0x00, 0x00, 0x00, 0x00,                  ## padding
                    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, ## global 0: NULL
                    0x00, 0x00, 0x01, 0x90, 0x00, 0x1c, 0x07, 0x1a, ## global 1: SP GCC CFA-anchored frame record x19-x21 N=25
                    0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00, 0x68, ## page 0: pc 0x10000 at 0x68
                    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, ## page 1: pc 0x20000 at 0x80
                    0x00, 0x00, 0x00, 0x30, 0x00, 0x00, 0x00, 0x00, ## end 0x20030
                    0x00, 0x02, 0x00, 0x10,                  ## page 0: 2 entries, local descriptors at +0x10
                    0x00, 0x00, 0x00, 0x01,                  ## 0x10000: descriptor 1 (SP GCC CFA-anchored)
                    0x00, 0x00, 0x40, 0x02,                  ## 0x10010: descriptor 2 (escape)
                    0x00, 0x00, 0x00, 0x00,                  ## padding
                    0x00, 0x00, 0x00, 0x00, 0x20, 0x00, 0x07, 0x03, ## local 0: escape, augmentations S, G and N, personality 1
                    0x00, 0x03, 0x00, 0x10,                  ## page 1: 3 entries, local descriptors at +0x10
                    0x00, 0x00, 0x00, 0x02,                  ## 0x20000: descriptor 2 (invalid)
                    0x00, 0x00, 0x40, 0x03,                  ## 0x20010: descriptor 3 (reserved mode)
                    0x00, 0x00, 0x80, 0x00,                  ## 0x20020: descriptor 0 (NULL)
                    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x01, ## local 0: FP x19 without a frame record (invalid)
                    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x07, ## local 1: reserved mode 7
                    0xff, 0xff, 0x00, 0x10, 0x00, 0x00, 0x00, 0xb0, ## side table 0 page 0: pc 0x10010 at 0xb0
                    0x00, 0x00, 0x00, 0x30, 0x00, 0x00, 0x00, 0x00, ## end 0x20030
                    0x00, 0x03, 0x00, 0x01,                  ## 3 rows, compressed
                    0x00, 0x01, 0x10, 0x00,                  ## base LSDA 0x31000
