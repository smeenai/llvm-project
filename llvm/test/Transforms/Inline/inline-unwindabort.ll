;; Ensure that inlining propagates unwindabort as expected:
;;
;; Unwindabort on a callsite attaches to all calls inlined through it that can
;; actually unwind. A 'nounwind' inlined call cannot throw, so it is NOT marked
;; 'unwindabort' (the marker would be inert but would force a spurious gap-LSDA
;; onto the caller, defeating ICF folding of otherwise-identical functions).
;;
;; A nounwind callsite propagates nounwind to calls inlined through
;; it, except that an unwindabort inner call cannot be deduced to be
;; nounwind, as it's unwind doesn't propagate out.
declare void @extern()
declare void @extern_nounwind() nounwind
declare i32 @__gxx_personality_v0(...)
declare i32 @_except_handler3(...)
declare void @maythrow()
declare void @other()
declare void @_ZdlPv(ptr) nounwind
@_ZTIi = external constant ptr

;.
; CHECK: @_ZTIi = external constant ptr
;.
define internal void @inlined_callee() personality ptr @__gxx_personality_v0 {
entry:
  call void @extern()
  call void @extern_nounwind() nounwind
  call unwindabort void @extern()
  call unwindabort void @extern_nounwind() nounwind
  ret void
}

define void @caller() {
;
; CHECK-LABEL: @caller(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    call void @extern()
; CHECK-NEXT:    call void @extern_nounwind() #[[ATTR0:[0-9]+]]
; CHECK-NEXT:    call unwindabort void @extern()
; CHECK-NEXT:    call unwindabort void @extern_nounwind() #[[ATTR0]]
; CHECK-NEXT:    ret void
;
entry:
  call void @inlined_callee()
  ret void
}

define void @nounwind_caller() {
;
; CHECK-LABEL: @nounwind_caller(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    call void @extern() #[[ATTR0]]
; CHECK-NEXT:    call void @extern_nounwind() #[[ATTR0]]
; CHECK-NEXT:    call unwindabort void @extern()
; CHECK-NEXT:    call unwindabort void @extern_nounwind() #[[ATTR0]]
; CHECK-NEXT:    ret void
;
entry:
  call void @inlined_callee() nounwind
  ret void
}

define void @unwindabort_caller() personality ptr @__gxx_personality_v0 {
;
; CHECK-LABEL: @unwindabort_caller(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    call unwindabort void @extern()
; CHECK-NEXT:    call void @extern_nounwind() #[[ATTR0]]
; CHECK-NEXT:    call unwindabort void @extern()
; CHECK-NEXT:    call unwindabort void @extern_nounwind() #[[ATTR0]]
; CHECK-NEXT:    ret void
;
entry:
  call unwindabort void @inlined_callee()
  ret void
}

define void @unwindabort_nounwind_caller() personality ptr @__gxx_personality_v0 {
;
; CHECK-LABEL: @unwindabort_nounwind_caller(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    call void @extern() #[[ATTR0]]
; CHECK-NEXT:    call void @extern_nounwind() #[[ATTR0]]
; CHECK-NEXT:    call unwindabort void @extern()
; CHECK-NEXT:    call unwindabort void @extern_nounwind() #[[ATTR0]]
; CHECK-NEXT:    ret void
;
entry:
  call unwindabort void @inlined_callee() nounwind
  ret void
}

;; Inlining a callee whose invoke has a non-exhaustive (catch-only) landingpad
;; through a 'call unwindabort' must (1) add a 'cleanup' clause to the inlined
;; landingpad and (2) convert its 'resume' to 'resume unwindabort'. Otherwise a
;; non-matching exception would escape the unwindabort scope instead of
;; terminating.
define internal void @callee_with_catch() personality ptr @__gxx_personality_v0 {
entry:
  invoke void @maythrow() to label %cont unwind label %lpad
cont:
  ret void
lpad:
  %0 = landingpad { ptr, i32 } catch ptr @_ZTIi
  resume { ptr, i32 } %0
}

define void @unwindabort_caller_with_catch() personality ptr @__gxx_personality_v0 {
; CHECK-LABEL: @unwindabort_caller_with_catch(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    invoke void @maythrow()
; CHECK-NEXT:            to label [[CALLEE_WITH_CATCH_EXIT:%.*]] unwind label [[LPAD_I:%.*]]
; CHECK:       lpad.i:
; CHECK-NEXT:    [[TMP0:%.*]] = landingpad { ptr, i32 }
; CHECK-NEXT:            cleanup
; CHECK-NEXT:            catch ptr @_ZTIi
; CHECK-NEXT:    resume unwindabort { ptr, i32 } [[TMP0]]
; CHECK:       callee_with_catch.exit:
; CHECK-NEXT:    ret void
;
entry:
  call unwindabort void @callee_with_catch()
  ret void
}

;; Real-world shape: a nounwind deallocation wrapper (e.g. libcxx's
;; __libcpp_deallocate, which just forwards to 'operator delete') inlined through
;; a 'call unwindabort' site. The inlined 'operator delete' is nounwind and
;; cannot throw, so it must NOT acquire an 'unwindabort' marker -- otherwise the
;; otherwise-nounwind caller is forced to carry a gap-LSDA, which prevents the
;; linker from ICF-folding the (many, identical) small cleanup functions.
define internal void @dealloc_wrapper(ptr %p) {
entry:
  call void @_ZdlPv(ptr %p)
  ret void
}

define void @unwindabort_inline_dealloc(ptr %p) personality ptr @__gxx_personality_v0 {
; CHECK-LABEL: @unwindabort_inline_dealloc(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    call void @_ZdlPv(ptr [[P:%.*]])
; CHECK-NEXT:    ret void
;
entry:
  call unwindabort void @dealloc_wrapper(ptr %p)
  ret void
}

;; Under an asynchronous-EH personality, 'nounwind' does NOT prove "cannot
;; unwind", so a nounwind call inlined through 'call unwindabort' must STILL be
;; marked 'unwindabort' (unlike the DWARF cases above). Mirrors the InstCombine
;; strip's canSimplifyInvokeNoUnwind guard.
define internal void @seh_callee() {
entry:
  call void @extern_nounwind() nounwind
  ret void
}

define void @unwindabort_caller_seh() personality ptr @_except_handler3 {
; CHECK-LABEL: @unwindabort_caller_seh(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    call unwindabort void @extern_nounwind() #[[ATTR0]]
; CHECK-NEXT:    ret void
;
entry:
  call unwindabort void @seh_callee()
  ret void
}

;; Inlining a callee that contains a 'call unwindabort' THROUGH AN INVOKE must
;; not turn that call into an invoke targeting the caller's unwind edge: that
;; would change terminate-on-unwind into propagation. It stays a call, while a
;; genuinely-throwing call (@other) is correctly converted to an invoke.
define internal void @callee_with_ua() personality ptr @__gxx_personality_v0 {
entry:
  call unwindabort void @maythrow()
  call void @other()
  ret void
}

define void @invoke_caller() personality ptr @__gxx_personality_v0 {
; CHECK-LABEL: @invoke_caller(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    call unwindabort void @maythrow()
; CHECK-NEXT:    invoke void @other()
; CHECK-NEXT:            to label [[CALLEE_WITH_UA_EXIT:%.*]] unwind label [[LPAD:%.*]]
; CHECK:       callee_with_ua.exit:
; CHECK-NEXT:    br label [[OK:%.*]]
; CHECK:       ok:
; CHECK-NEXT:    ret void
; CHECK:       lpad:
; CHECK-NEXT:    [[L:%.*]] = landingpad { ptr, i32 }
; CHECK-NEXT:            cleanup
; CHECK-NEXT:    resume { ptr, i32 } [[L]]
;
entry:
  invoke void @callee_with_ua() to label %ok unwind label %lpad
ok:
  ret void
lpad:
  %l = landingpad { ptr, i32 } cleanup
  resume { ptr, i32 } %l
}

