// RUN: cir-opt %s -cir-to-llvm -o %t.mlir
// RUN: FileCheck --input-file=%t.mlir %s --check-prefix=MLIR
// RUN: cir-translate %s -cir-to-llvmir --target x86_64-unknown-linux-gnu -o %t.ll
// RUN: FileCheck --input-file=%t.ll %s --check-prefix=LLVM

!s32i = !cir.int<s, 32>

module attributes {cir.triple = "x86_64-unknown-linux-gnu"} {

cir.func private @f()
cir.func private @__gxx_personality_v0(...) -> !s32i

cir.func @caller() personality(@__gxx_personality_v0) {
  cir.call @f() unwindabort : () -> ()
  cir.return
}

}

// MLIR: llvm.func @caller() attributes {personality = @__gxx_personality_v0} {
// MLIR:   llvm.call @f() {unwind_abort} : () -> ()

// LLVM: define void @caller() personality ptr @__gxx_personality_v0 {
// LLVM:   call unwindabort void @f()
